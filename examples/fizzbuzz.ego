# ego version 0.1.0
# this example demonstrates the classic FizzBuzz problem

:fizzbuzz n
    for i := 1 to n 
        printed := false
        if i % 15 == 0
            put('FizzBuzz')
            printed := true
        ;
        if i % 3 == 0 and !printed
            put('Fizz')
            printed := true
        ;
        if i % 5 == 0 and !printed
            put('Buzz')
            printed := true
        ;
        if !printed
            put(i)
        ;
    ;
;

fizzbuzz(100)