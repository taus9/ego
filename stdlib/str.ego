:toUpper s
    expect(s, 'string', 'toUpper', 1)
    new := ''
    # loop through every character in s
    for _, c in s
        u := when c
            is 'a': 'A'
            is 'b': 'B'
            is 'c': 'C'
            is 'd': 'D'
            is 'e': 'E'
            is 'f': 'F'
            is 'g': 'G'
            is 'h': 'H'
            is 'i': 'I'
            is 'j': 'J'
            is 'k': 'K'
            is 'l': 'L'
            is 'm': 'M'
            is 'n': 'N'
            is 'o': 'O'
            is 'p': 'P'
            is 'q': 'Q'
            is 'r': 'R'
            is 's': 'S'
            is 't': 'T'
            is 'u': 'U'
            is 'v': 'V'
            is 'w': 'W'
            is 'x': 'X'
            is 'y': 'Y'
            is 'z': 'Z'
            else: c     # if the character isn't a letter return it as-is
        ;
        new = new + u
    ;
    ret new
;

:toLower s
    expect(s, 'string', 'toLower', 1)
    new := ''
    # loop through every character in s
    for _, c in s
        l := when c
            is 'A': 'a'
            is 'B': 'b'
            is 'C': 'c'
            is 'D': 'd'
            is 'E': 'e'
            is 'F': 'f'
            is 'G': 'g'
            is 'H': 'h'
            is 'I': 'i'
            is 'J': 'j'
            is 'K': 'k'
            is 'L': 'l'
            is 'M': 'm'
            is 'N': 'n'
            is 'O': 'o'
            is 'P': 'p'
            is 'Q': 'q'
            is 'R': 'r'
            is 'S': 's'
            is 'T': 't'
            is 'U': 'u'
            is 'V': 'v'
            is 'W': 'w'
            is 'X': 'x'
            is 'Y': 'y'
            is 'Z': 'z'
            else: c     # if the character isn't a letter return it as-is
        ;
        new = new + l
    ;
    ret new
;

:indexOf s, substr
    expect(s, 'string', 'indexOf', 1)
    expect(substr, 'string', 'indexOf', 2)
    if substr == ''
        ret 0
    ;
    strLen := len(s)
    substrLen := len(substr)
    if substrLen > strLen
        ret -1
    ;
    for i := 0 to strLen - substrLen
        strSlice := slice(s, i, i + substrLen)
        if strSlice == substr
            ret i
        ;
    ;
    ret -1
;

:slice s, start, end
    expect(s, 'string', 'slice', 1)
    expect(start, 'integer', 'slice', 2)
    expect(end, 'integer', 'slice', 3)
    sLen := len(s)
    if start < 0 or end < 0 or start > sLen or end > sLen or start > end
        ret error('slice() indices out of range: ' + str(start) + ', ' + str(end) + ' for string of length ' + str(sLen))
    ;
    new := ''
    for i := 0 to sLen - 1
        if i >= start and i < end
            new = new + s[i]
        ;
    ;
    ret new
;