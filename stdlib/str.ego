:toUpper string
    if type(string) != 'string'
        err('toUpper() expected a string argument, got ' + type(string))
    ;
    new := ''
    # loop through every character in string
    for _, c in string
        u := when c
            is 'a': 'A'
            is 'b': 'B'
            is 'c': 'C'
            is 'd': 'D'
            is 'e': 'E'
            is 'f': 'F'
            is 'g': 'G'
            is 'h': 'H'
            is 'i': 'I'
            is 'j': 'J'
            is 'k': 'K'
            is 'l': 'L'
            is 'm': 'M'
            is 'n': 'N'
            is 'o': 'O'
            is 'p': 'P'
            is 'q': 'Q'
            is 'r': 'R'
            is 's': 'S'
            is 't': 'T'
            is 'u': 'U'
            is 'v': 'V'
            is 'w': 'W'
            is 'x': 'X'
            is 'y': 'Y'
            is 'z': 'Z'
            else: c     # if the character isn't a letter return it as-is
        ;
        new = new + u
    ;
    ret new
;

:toLower string
    if type(string) != 'string'
        err('toLower() expected a string argument, got ' + type(string))
    ;
    new := ''
    # loop through every character in string
    for _, c in string
        l := when c
            is 'A': 'a'
            is 'B': 'b'
            is 'C': 'c'
            is 'D': 'd'
            is 'E': 'e'
            is 'F': 'f'
            is 'G': 'g'
            is 'H': 'h'
            is 'I': 'i'
            is 'J': 'j'
            is 'K': 'k'
            is 'L': 'l'
            is 'M': 'm'
            is 'N': 'n'
            is 'O': 'o'
            is 'P': 'p'
            is 'Q': 'q'
            is 'R': 'r'
            is 'S': 's'
            is 'T': 't'
            is 'U': 'u'
            is 'V': 'v'
            is 'W': 'w'
            is 'X': 'x'
            is 'Y': 'y'
            is 'Z': 'z'
            else: c     # if the character isn't a letter return it as-is
        ;
        new = new + l
    ;
    ret new
;

:indexOf s, substr
    if type(s) != 'string'
        err('indexOf() expected first argument to be a string, got ' + type(s))
    ;
    if type(substr) != 'string'
        err('indexOf() expected second argument to be a string, got ' + type(substr))
    ;
    if substr == ''
        ret 0
    ;
    for i := 0 to len(s) - len(substr)
        strSlice := slice(s, i, i + len(substr))
        if strSlice == substr
            ret i
        ;
    ;
    ret -1
;

:slice string, start, end
    if type(string) != 'string'
        err('slice() expected first argument to be a string, got ' + type(string))
    ;
    if type(start) != 'integer'
        err('slice() expected second argument to be an integer, got ' + type(start))
    ;
    if type(end) != 'integer'
        err('slice() expected third argument to be an integer, got ' + type(end))
    ;
    if start < 0 or end < 0 or start > len(string) or end > len(string) or start > end
        err('slice() indices out of range: ' + start + ', ' + end + ' for string of length ' + len(string))
    ;
    new := ''
    for i := 0 to len(string) - 1
        if i >= start and i < end
            new = new + string[i]
        ;
    ;
    ret new
;