# ego version 0.1.0
# this example demonstrates how to compute Fibonacci numbers iteratively

:fib n
    if n <= 1
        ret n
    ;

    a := 0
    b := 1
    
    next := 0

    for i := 2 to n
        next = a + b
        a = b
        b = next
    ;

    ret b
;

for i := 0 to 10
    put(fib(i))
;