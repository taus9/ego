# ego version 0.1.0

# there are four types of for loops in ego

# 1. counting loop: for i := start to end (inclusive)
for i := 0 to 4
    put(i)
;

# 2. reverse counting loop: for i := end to start (inclusive)
for j := 4 to 0
    put(j)
;

# 3. conditional loop: for condition (runs while condition is true)
k := 0
for k < 5
    put(k)
    k = k + 1
;

# 4. iterating over arrays, the first variable is the index, the second is the value
arr := [10, 20, 30, 40, 50]
for index, value in arr
    put('Index: ' + str(index) + ', Value: ' + str(value))
;

# 5. iterating over maps, the first variable is the key, the second is the value
m := {
    'a': 1,
    'b': 2,
    'c': 3
}
for key, val in m
    put('Key: ' + key + ', Value: ' + str(val))
;